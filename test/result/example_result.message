est is sent"},{"id":"e32bf1a9-3c2d-4ce9-a034-734ac930f89a","location":{"line":33,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the response should be a valid \"sdmx-json\""},{"id":"effc1d91-3a55-4138-9d5b-8bcd778db99d","location":{"line":34,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the observation \"AREA001.F.TRUE.ALL\" should be 3421"},{"id":"49ff0941-7b00-4b29-8899-f59ee19155bc","location":{"line":35,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the observation \"AREA001.F.FALSE.ALL\" should be 60391"},{"id":"abf02626-e567-42a2-8dcd-6c3a253a0df1","location":{"line":36,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the observation \"AREA001.M.TRUE.ALL\" should be 2876"},{"id":"c759e06c-09f4-432c-bd6b-56cbf7bb05d2","location":{"line":37,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the observation \"AREA001.M.FALSE.ALL\" should be 58642"}],"examples":[]}},{"scenario":{"id":"90055845-148e-43c0-813a-dab79283974c","tags":[{"location":{"line":39,"column":3},"name":"@functional","id":"a168fd8e-4901-4bcf-9d73-8eebaf2e4ee8"},{"location":{"line":39,"column":15},"name":"@mock","id":"3425aca6-a766-4959-b138-cd35a7348c00"}],"location":{"line":40,"column":3},"keyword":"Scenario","name":"A small count is suppressed and an empty cell flagged","description":"","steps":[{"id":"cedac971-f1b6-4a64-9233-73d44ab43475","location":{"line":41,"column":5},"keyword":"Given ","keywordType":"Context","text":"the member statistics query \"suppressed\""},{"id":"1244dc99-cf6c-46a7-b146-4b1a59c983b1","location":{"line":42,"column":5},"keyword":"When ","keywordType":"Action","text":"the request is sent"},{"id":"1fffcdae-bfbd-48b3-9d86-4afab1e7aaf1","location":{"line":43,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the response should be a valid \"sdmx-json\""},{"id":"681fd7fb-be9c-44b0-9802-b73183ea49ed","location":{"line":44,"column":5},"keyword":"And ","keywordType":"Conjunction","text